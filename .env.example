# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_password_here
DB_NAME=wealthflow_db

# Server Configuration
PORT=3000
NODE_ENV=development

# Security (IMPORTANT: Generate secure secrets in production!)
# Generate a secure JWT_SECRET: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_CHANGE_THIS_IN_PRODUCTION
BCRYPT_ROUNDS=10

# Timeouts (in milliseconds)
AUTH_TIMEOUT_MS=8000
PARSE_FILE_TIMEOUT_MS=15000

# CORS Configuration
# For production, set to your actual frontend domain
# Example: ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: Email Configuration (for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# EMAIL_FROM=noreply@wealthflow.com
